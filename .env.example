# Copy to .env.local. With no Supabase values the app runs in demo mode on seeded in-memory data.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (PostgreSQL + Auth + Storage). All three enable production mode. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Signs demo-mode sessions. Required in production if Supabase is not configured.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Google sign-in without Supabase (Google Cloud Console → Credentials → OAuth client, "Web application").
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/auth/google/callback
# With Supabase, configure Google on the Supabase project instead, then set SUPABASE_GOOGLE_AUTH=on
# so the "Continue with Google" button appears.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_GOOGLE_AUTH=off

# --- AI provider. Without a key, the deterministic rules engine is used. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Background worker. Vercel Cron sends this as a Bearer token to /api/cron/worker. ---
CRON_SECRET=

# Comma-separated emails promoted to admin on sign-in (bootstrap a fresh project).
ADMIN_EMAILS=

# Password assigned to every account created by `npm run seed -- --demo` (Supabase demo/staging only).
SEED_DEMO_PASSWORD=

# =====================================================================================
# Reference data & verification. All optional: the keyless defaults work out of the box.
# =====================================================================================

# Stack Exchange API key (https://stackapps.com/apps/oauth/register). Raises the skill-lookup
# quota from 300 to 10,000 requests/day per IP. Not a secret, but keep it server-side.
STACKEXCHANGE_KEY=
# Lightcast Open Skills (https://lightcast.io/open-skills/access). Adds ~33k skills to search
# and verification. Client-credentials pair; server-only.
LIGHTCAST_CLIENT_ID=
LIGHTCAST_CLIENT_SECRET=
# GitHub token with NO scopes (fine-grained, public repositories read-only). Raises the GitHub
# profile-check limit from 60 to 5,000 requests/hour. Server-only.
GITHUB_TOKEN=
# "off" skips the DNS check on sign-up email domains (only for offline sandboxes).
EMAIL_DOMAIN_CHECK=on

# =====================================================================================
# Job sources. Arbeitnow is keyless and always on; the others switch on when configured.
# =====================================================================================

# Optional allow-list, e.g. "arbeitnow,adzuna". Empty = every configured source.
JOB_SOURCES=
# Listings older than this many days are closed.
JOB_MAX_AGE_DAYS=45
# Adzuna (https://developer.adzuna.com): free developer keys. Countries are Adzuna market codes.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=gb,us,de,in
# The Muse (https://www.themuse.com/developers/api/v2): register an app for a key.
MUSE_API_KEY=
# Public Greenhouse / Lever job boards to include, by board token / company slug
# (e.g. GREENHOUSE_BOARDS=acme,globex). Only add boards whose terms allow aggregation.
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
